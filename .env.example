# DataSentinel Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your local or production environment.

# Environment mode (development, staging, production)
ENVIRONMENT=development

# Pipeline identification
PIPELINE_NAME=DataSentinel
LOG_LEVEL=INFO

# Storage paths
STORAGE_BASE_DIR=data
DATA_LANDING_DIR=data/landing
DATA_PROCESSED_DIR=data/processed
DATA_QUARANTINE_DIR=data/quarantine
DATA_REPORTS_DIR=data/reports
METADATA_DB_PATH=data/metadata/schemaguard_metadata.duckdb

# Streamlit Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
